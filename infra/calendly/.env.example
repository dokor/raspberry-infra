# Domaine public
NEXT_PUBLIC_WEBAPP_URL=https://cal.ton-domaine.tld

# Auth
NEXTAUTH_URL=https://cal.ton-domaine.tld/api/auth
NEXTAUTH_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# Chiffrement interne Cal.com
CALENDSO_ENCRYPTION_KEY=CHANGE_ME_LONG_RANDOM_KEY

# Base de données
POSTGRES_USER=calcom
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=calcom

DATABASE_URL=postgresql://calcom:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/calcom

# Optionnel mais utile
NODE_ENV=production