# Images
# Required: set this to the exact n8n version validated on the Raspberry.
# Example format: n8nio/n8n:X.Y.Z
N8N_IMAGE=
CODEX_RUNTIME_IMAGE=ghcr.io/dokor/codex-runtime:0.156.1-r1

# Host binding
# Keep n8n local by default. Use Traefik for remote exposure.
N8N_BIND_ADDRESS=127.0.0.1

# Core n8n settings
N8N_ENCRYPTION_KEY=replace-with-the-existing-key
N8N_BASIC_AUTH_ACTIVE=false
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
N8N_EDITOR_BASE_URL=
WEBHOOK_URL=
TZ=Europe/Brussels

# Reuse the current prospection-auto n8n data volume during migration.
N8N_DATA_VOLUME=prospection-auto_n8n_data

# Shared Codex bridge
# Generate with: openssl rand -hex 32
CODEX_BRIDGE_TOKEN=replace-with-a-long-random-secret
CODEX_BRIDGE_URL=http://codex-bridge:3010
CODEX_MAX_CONCURRENCY=1
CODEX_TIMEOUT_MS=180000
CODEX_MAX_BODY_BYTES=262144
CODEX_HOME_VOLUME=codex_bridge_home

# Shared browser automation worker
BROWSER_AUTOMATIONS_URL=http://browser-automations:3000
# Must match the GitHub Actions secret used by infra/automations.
AUTOMATION_API_TOKEN=replace-with-the-same-long-random-secret

# Temporary migration compatibility: prospection-auto
SEARXNG_BASE_URL=http://searxng:8080
LINKEDIN_WORKER_URL=http://linkedin-worker:3000
ARGOS_BASE_URL=https://argos.lelouet.fr
N8N_REVIEW_FORM_URL=http://localhost:5678/form/prospect-review
DRY_RUN=true
